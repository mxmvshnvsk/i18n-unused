{
  "name": "i18n-unused",
  "version": "0.21.0",
  "description": "The tool for finding, analyzing and removing unused and missed i18n translations in your JavaScript project",
  "type": "module",
  "source": "src/index.ts",
  "bin": "bin/i18n-unused.cjs",
  "main": "dist/i18n-unused.cjs",
  "module": "dist/i18n-unused.js",
  "types": "dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "require": "./dist/i18n-unused.cjs",
    "import": "./dist/i18n-unused.js"
  },
  "files": [
    "*"
  ],
  "scripts": {
    "test": "env NODE_OPTIONS=--no-experimental-webstorage jest",
    "build": "rm -rf dist && microbundle --target node",
    "prepare": "npm run build",
    "lint": "eslint ./src --ext .ts",
    "lint-fix": "eslint ./src --ext .ts --fix",
    "format-code": "prettier --config .prettierrc 'src/**/*.ts' --write"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxmvshnvsk/i18n-unused.git"
  },
  "keywords": [
    "i18n"
  ],
  "author": "Maxim Vishnevsky",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mxmvshnvsk/i18n-unused/issues"
  },
  "homepage": "https://github.com/mxmvshnvsk/i18n-unused#readme",
  "devDependencies": {
    "@babel/types": "^7.14.5",
    "@types/babel__traverse": "^7.14.1",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "microbundle": "^0.13.3",
    "prettier": "^3.0.0",
    "ts-jest": "^29.2.6",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@babel/parser": "^7.14.7",
    "@babel/traverse": "^7.14.7",
    "commander": "^10.0.1",
    "esm": "^3.2.25",
    "ts-import": "^2.0.40"
  },
  "overrides": {
    "serialize-javascript": "^7.1.0",
    "@rollup/pluginutils": "3.1.0"
  },
  "//": {
    "serialize-javascript": "Resolves high-severity RCE advisory in rollup-plugin-terser (transitive dependency of microbundle)",
    "@rollup/pluginutils": "Ensures cross-platform TypeScript path/glob resolution in rollup-plugin-typescript2 on Windows"
  }
}